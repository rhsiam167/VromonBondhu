# Copy this file to ".env" (same folder) and fill in your own values.
# .env holds secrets — it must NEVER be committed to git.

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://vromon:vromon_dev_password@localhost:5432/vromon_bondhu

# Secret used to sign login tokens (JWT). Use a long random value, for example the
# output of:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# How long a login token stays valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend address(es) allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Largest request body accepted, in bytes (262144 = 256 KB)
MAX_REQUEST_BYTES=262144

# Login protection: after this many failed logins for one email from one address,
# further attempts are refused for LOGIN_WINDOW_SECONDS
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
